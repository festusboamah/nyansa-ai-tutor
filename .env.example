# Required: generate a unique value with the command in README.md.
DJANGO_SECRET_KEY=replace-with-a-unique-secret
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Optional: point migration rehearsals at a copied SQLite database.
# NYANSA_SQLITE_PATH=C:\path\to\copied-db.sqlite3

# Required for Claude-powered features.
ANTHROPIC_API_KEY=your-anthropic-api-key

# Optional SMTP settings. The console backend is used by default.
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_USE_TLS=True
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=Nyansa <noreply@nyansa.com>
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=Nyansa
ARKESEL_SMS_ENDPOINT=https://sms.arkesel.com/api/v2/sms/send
PAYSTACK_SECRET_KEY=
ANALYTICS_AI_NARRATIVES=False
ANALYTICS_AI_MODEL=claude-sonnet-4-5
DJANGO_ENV=development
NYANSA_DEMO_MODE=False
DATABASE_URL=
DATABASE_CONN_MAX_AGE=60
DJANGO_CSRF_TRUSTED_ORIGINS=
DJANGO_TRUST_PROXY_SSL_HEADER=False
DJANGO_SECURE_HSTS_SECONDS=3600
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=False
DJANGO_SECURE_HSTS_PRELOAD=False
DJANGO_LOG_LEVEL=INFO
NYANSA_MEDIA_ROOT=
DJANGO_FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DJANGO_DATA_UPLOAD_MAX_MEMORY_SIZE=10485760
